{
    "name": "planet-oxy",
    "version": "0.0.1",
    "private": true,
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.2"
    },
    "scripts": {
        "dev": "vite dev --port 8008",
        "launch": "vite dev --port 8008 --open",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "init:gql": "bunx houdini@next init",
        "generate:gql": "bunx houdini generate",
        "pull:gql": "bun --env-file=.env houdini pull-schema"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/bun": "^1.4.2",
        "@types/eslint": "^9.6.1",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.11.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "houdini": "^2.0.11",
        "houdini-svelte": "^3.0.6",
        "mdsvex": "^0.12.8",
        "prettier": "^3.9.8",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0"
    },
    "type": "module",
    "dependencies": {
        "@sanity/client": "^8.6.2",
        "@tailwindcss/vite": "^4.3.3",
        "gray-matter": "^4.0.3",
        "highlight.js": "^11.12.0",
        "marked": "^18.0.13",
        "marked-highlight": "^2.2.4"
    }
}